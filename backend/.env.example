# ==============================================================================
# VISION_FLOW Backend Environment Configuration (Example)
# Copy this file to .env and fill in your real credentials.
# Never commit real passwords or secrets to Git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME=VISION_FLOW
VERSION=0.1.0

# Database Configuration (PostgreSQL + PostGIS)
# AsyncPG Driver URL format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://visionflow:your_password_here@127.0.0.1:5432/vision_flow

# Individual Connection Parameters (Alternative / Fallback)
POSTGRES_USER=visionflow
POSTGRES_PASSWORD=your_password_here
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=vision_flow

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
