# ==============================================================================
# VISION_FLOW - Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & Environment
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# IDEs and Editors
# ------------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
*.bak

# ------------------------------------------------------------------------------
# Environment Variables, Secrets & Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
secrets/
private/

# ------------------------------------------------------------------------------
# Node / Frontend (React, Vite, TypeScript, Tailwind)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
dist/
dist-ssr/
build/
.vite/
.turbo/
.cache/
coverage/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Python / Backend (FastAPI, Pytest, Uvicorn)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Python Tooling & Caches
.pytest_cache/
.coverage
.coverage.*
.mypy_cache/
.ruff_cache/
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# ------------------------------------------------------------------------------
# Computer Vision & Large AI/ML Models
# ------------------------------------------------------------------------------
*.pt
*.pth
*.onnx
*.engine
*.tflite
*.weights
*.safetensors
*.bin
*.h5
*.pkl
*.joblib
models/checkpoints/
models/weights/

# ------------------------------------------------------------------------------
# Large Datasets, Video Feeds & Media
# ------------------------------------------------------------------------------
data/sample_videos/*
!data/sample_videos/.gitkeep
!data/sample_videos/README.md
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.mp4
*.avi
*.mov
*.mkv
*.wmv
*.flv
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# ------------------------------------------------------------------------------
# Databases & Local Storage
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
postgres-data/
redis-data/

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
tmp/
temp/
